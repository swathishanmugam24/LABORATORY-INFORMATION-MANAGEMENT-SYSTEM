    private void refreshInventoryTable(String filter) {
        if (inventoryTableModel==null) return;
        inventoryTableModel.setRowCount(0);
        for (InventoryItem it : inventory) {
            String comb = (it.id + " " + it.name + " " + it.category + " " + it.location + " " + it.notes).toLowerCase();
            if (!filter.isEmpty() && !comb.contains(filter.toLowerCase())) continue;
            inventoryTableModel.addRow(new Object[]{it.id, it.name, it.category, it.stock, it.location, it.notes});
        }
    }

    private InventoryItem findInventoryItem(String id) {
        for (InventoryItem it : inventory) if (it.id.equals(id)) return it;
        return null;
    }

