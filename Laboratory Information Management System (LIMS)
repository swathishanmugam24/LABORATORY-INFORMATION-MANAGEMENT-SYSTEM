            requestTableModel.addRow(new Object[]{r.id, r.requestedBy, r.type, r.targetId, r.details, r.requestedAt.format(dtf), r.status, r.resolvedBy==null?"":r.resolvedBy, r.resolvedAt==null?"": (r.resolvedAt.format(dtf))});
        }
    }

