        JTextField txtDisplay = new JTextField(20);
        String[] roles = {"Admin","Technician","Researcher"};
        JComboBox<String> cbRole = new JComboBox<>(roles);
        JPasswordField pass = new JPasswordField(20);

        if (toEdit!=null) {
            txtUser.setText(toEdit.username); txtUser.setEditable(false);
            txtDisplay.setText(toEdit.displayName);
            cbRole.setSelectedItem(toEdit.role);
        }

        gbc.gridx=0; gbc.gridy=0; p.add(new JLabel("Username:"), gbc);
        gbc.gridx=1; p.add(txtUser, gbc);
        gbc.gridx=0; gbc.gridy=1; p.add(new JLabel("Display Name:"), gbc);
        gbc.gridx=1; p.add(txtDisplay, gbc);
        gbc.gridx=0; gbc.gridy=2; p.add(new JLabel("Role:"), gbc);
        gbc.gridx=1; p.add(cbRole, gbc);
        gbc.gridx=0; gbc.gridy=3; p.add(new JLabel("Password:"), gbc);
        gbc.gridx=1; p.add(pass, gbc);

        JButton btnSave = new JButton("Save"); JButton btnCancel = new JButton("Cancel");
        JPanel bp = new JPanel(); bp.add(btnSave); bp.add(btnCancel);
        gbc.gridx=0; gbc.gridy=4; gbc.gridwidth=2; p.add(bp, gbc);

        btnSave.addActionListener(e -> {
            String uname = txtUser.getText().trim();
            String dname = txtDisplay.getText().trim();
            String role = (String) cbRole.getSelectedItem();
            String pw = new String(pass.getPassword()).trim();
            if (uname.isEmpty() || dname.isEmpty() || role.isEmpty()) { JOptionPane.showMessageDialog(dlg, "Fill required fields"); return; }
            if (toEdit==null && users.stream().anyMatch(x->x.username.equalsIgnoreCase(uname))) { JOptionPane.showMessageDialog(dlg,"Username exists"); return; }
            if (toEdit==null) {
                if (pw.isEmpty()) { JOptionPane.showMessageDialog(dlg,"Password required"); return; }
                users.add(new User(uname, dname, role, sha256(pw)));
                logs.add(new AuditLog(LocalDateTime.now(), currentUser, "Added user " + uname));
            } else {
                toEdit.displayName = dname;
                toEdit.role = role;
                if (!pw.isEmpty()) toEdit.passwordHash = sha256(pw);
                logs.add(new AuditLog(LocalDateTime.now(), currentUser, "Updated user " + toEdit.username));
            }
            saveAll();
            refreshUserTable();
            dlg.dispose();
        });
        btnCancel.addActionListener(e -> dlg.dispose());

        dlg.add(p);
        dlg.setVisible(true);
    }

