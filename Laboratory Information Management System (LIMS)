    private void handleLogin() {
        String user = txtUsername.getText().trim();
        String pass = new String(txtPassword.getPassword());
        if (user.isEmpty() || pass.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Enter username and password");
            return;
        }
        Optional<User> u = users.stream().filter(x -> x.username.equalsIgnoreCase(user)).findFirst();
        if (!u.isPresent()) {
            JOptionPane.showMessageDialog(this, "Unknown user");
            return;
        }
        User found = u.get();
        if (!found.passwordHash.equals(sha256(pass))) {
            JOptionPane.showMessageDialog(this, "Invalid credentials");
            return;
        }
        // success
        currentUser = found.username;
        currentRole = found.role;
        logs.add(new AuditLog(LocalDateTime.now(), currentUser, "Logged in"));
        saveAll();

        // show appropriate dashboard
        if ("Admin".equalsIgnoreCase(currentRole)) cardsLayout.show(cards, "admin");
        else if ("Technician".equalsIgnoreCase(currentRole)) cardsLayout.show(cards, "technician");
        else cardsLayout.show(cards, "researcher");

        refreshAllTables();
    }

