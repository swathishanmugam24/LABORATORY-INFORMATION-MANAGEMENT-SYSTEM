    private void refreshReservationTable(String filter) {
        if (reservationTableModel==null) return;
        reservationTableModel.setRowCount(0);
        for (EquipmentReservation r : reservations) {
            InventoryItem it = findInventoryItem(r.equipmentId);
            String name = it==null? r.equipmentId : it.name;
            String comb = (r.id + " " + name + " " + r.reservedBy + " " + r.purpose + " " + r.status).toLowerCase();
            if (!filter.isEmpty() && !comb.contains(filter.toLowerCase())) continue;
            reservationTableModel.addRow(new Object[]{r.id, r.equipmentId, name, r.reservedBy, r.start.format(dtf), r.end.format(dtf), r.purpose, r.status});
        }
    }

    private EquipmentReservation findReservation(String id) { for (EquipmentReservation r : reservations) if (r.id.equals(id)) return r; return null; }

    private void openReservationDialog(EquipmentReservation toEdit) {
        JDialog dlg = new JDialog(this, toEdit==null ? "Request Reservation" : "Edit Reservation", true);
        dlg.setSize(520,420); dlg.setLocationRelativeTo(this);
        JPanel p = new JPanel(new GridBagLayout()); GridBagConstraints gbc = new GridBagConstraints(); gbc.insets = new Insets(8,8,8,8); gbc.fill = GridBagConstraints.HORIZONTAL;

        JTextField txtId = new JTextField(14);
        JComboBox<String> cbEquip = new JComboBox<>();
        for (InventoryItem it : inventory) if ("Equipment".equalsIgnoreCase(it.category)) cbEquip.addItem(it.id + " - " + it.name);
        JTextField txtBy = new JTextField(14);
        JTextField txtStart = new JTextField(16); JTextField txtEnd = new JTextField(16);
        JTextArea txtPurpose = new JTextArea(4,24);
        if (toEdit!=null) {
            txtId.setText(toEdit.id); txtId.setEditable(false);
            for (int i=0;i<cbEquip.getItemCount();i++) if (cbEquip.getItemAt(i).startsWith(toEdit.equipmentId)) { cbEquip.setSelectedIndex(i); break; }
            txtBy.setText(toEdit.reservedBy); txtStart.setText(toEdit.start.format(dtf)); txtEnd.setText(toEdit.end.format(dtf)); txtPurpose.setText(toEdit.purpose);
        } else {
            txtId.setText(generateId("ER")); txtBy.setText(currentUser==null?"":currentUser); txtStart.setText(LocalDateTime.now().format(dtf)); txtEnd.setText(LocalDateTime.now().plusHours(1).format(dtf));
        }

        gbc.gridx=0; gbc.gridy=0; p.add(new JLabel("ID:"), gbc); gbc.gridx=1; p.add(txtId, gbc);
        gbc.gridx=0; gbc.gridy=1; p.add(new JLabel("Equipment:"), gbc); gbc.gridx=1; p.add(cbEquip, gbc);
        gbc.gridx=0; gbc.gridy=2; p.add(new JLabel("Requested By:"), gbc); gbc.gridx=1; p.add(txtBy, gbc);
        gbc.gridx=0; gbc.gridy=3; p.add(new JLabel("Start (yyyy-MM-dd HH:mm):"), gbc); gbc.gridx=1; p.add(txtStart, gbc);
        gbc.gridx=0; gbc.gridy=4; p.add(new JLabel("End (yyyy-MM-dd HH:mm):"), gbc); gbc.gridx=1; p.add(txtEnd, gbc);
        gbc.gridx=0; gbc.gridy=5; p.add(new JLabel("Purpose/Details:"), gbc); gbc.gridx=1; p.add(new JScrollPane(txtPurpose), gbc);

        JButton btnSave = new JButton("Submit Request"); JButton btnCancel = new JButton("Cancel");
        JPanel bp = new JPanel(); bp.add(btnSave); bp.add(btnCancel); gbc.gridx=0; gbc.gridy=6; gbc.gridwidth=2; p.add(bp, gbc);

        btnSave.addActionListener(e -> {
            String id = txtId.getText().trim(); String equipSel = (String) cbEquip.getSelectedItem(); String by = txtBy.getText().trim();
            String startS = txtStart.getText().trim(); String endS = txtEnd.getText().trim(); String purpose = txtPurpose.getText().trim();
            if (id.isEmpty() || equipSel==null || by.isEmpty() || startS.isEmpty() || endS.isEmpty()) { JOptionPane.showMessageDialog(dlg,"Fill required fields"); return; }
            String equipId = equipSel.split(" - ")[0];
            LocalDateTime start, end;
            try { start = LocalDateTime.parse(startS, dtf); end = LocalDateTime.parse(endS, dtf); } catch (Exception ex) { JOptionPane.showMessageDialog(dlg,"Invalid date/time"); return; }
            if (!end.isAfter(start)) { JOptionPane.showMessageDialog(dlg,"End must be after start"); return; }

            // conflict detection for approved reservations
            boolean conflict = reservations.stream().filter(r-> !r.id.equals(id) && r.equipmentId.equals(equipId) && "Approved".equalsIgnoreCase(r.status))
                    .anyMatch(r -> timesOverlap(r.start, r.end, start, end));
            if (conflict) {
                int ans = JOptionPane.showConfirmDialog(dlg, "There is a scheduling conflict with an approved reservation. Submit as Pending anyway?", "Conflict", JOptionPane.YES_NO_OPTION);
                if (ans!=JOptionPane.YES_OPTION) return;
            }

            if (toEdit==null) {
                EquipmentReservation er = new EquipmentReservation(id, equipId, by, start, end, purpose, "Pending");
                reservations.add(er);
                requests.add(new RequestItem(generateId("RQ"), by, "Equipment", id, "Reservation request for " + equipId, "Pending", LocalDateTime.now()));
                logs.add(new AuditLog(LocalDateTime.now(), currentUser, "Requested reservation " + id));
            } else {
                toEdit.equipmentId = equipId; toEdit.reservedBy = by; toEdit.start = start; toEdit.end = end; toEdit.purpose = purpose;
                logs.add(new AuditLog(LocalDateTime.now(), currentUser, "Updated reservation " + id));
            }
            saveAll(); refreshReservationTable(""); dlg.dispose();
        });
        btnCancel.addActionListener(e -> dlg.dispose());

        dlg.add(p); dlg.setVisible(true);
    }

    private boolean timesOverlap(LocalDateTime aStart, LocalDateTime aEnd, LocalDateTime bStart, LocalDateTime bEnd) {
        return !(aEnd.isBefore(bStart) || aStart.isAfter(bEnd) || aEnd.equals(bStart) || aStart.equals(bEnd));
    }

