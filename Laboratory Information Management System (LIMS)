    private String generateId(String prefix) {
        return prefix + "-" + (System.currentTimeMillis() % 100000) + "-" + (int)(Math.random()*900 + 100);
    }

    private boolean confirm(String msg) {
        return JOptionPane.showConfirmDialog(this, msg, "Confirm", JOptionPane.YES_NO_OPTION) == JOptionPane.YES_OPTION;
    }

    private static String esc(String s) { if (s==null) return ""; return s.replace(",",";").replace("\n"," "); }

    private static String sha256(String text) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            byte[] b = md.digest(text.getBytes("UTF-8"));
            StringBuilder sb = new StringBuilder();
            for (byte x : b) sb.append(String.format("%02x", x));
            return sb.toString();
        } catch (Exception ex) { return text; }
    }

